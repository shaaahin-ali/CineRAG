# ── Environment ───────────────────────────────────────────────────────────────
FASTAPI_ENV=development
FASTAPI_PORT=8000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: https://supabase.com → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY_HERE

# ── Pinecone ──────────────────────────────────────────────────────────────────
# OpenAI path: dimension=3072 | Gemini path: dimension=768, metric=cosine, serverless
# Get from: https://pinecone.io → API Keys
PINECONE_API_KEY=YOUR_PINECONE_API_KEY_HERE
PINECONE_INDEX_NAME=cinephile

# ── Gemini (recommended — free tier, no torch download) ───────────────────────
# Get from: https://aistudio.google.com/apikey
# Uses gemini-embedding-001 (768 dims) + gemini-2.0-flash for chat
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSION=768
GEMINI_CHAT_MODEL=gemini-2.0-flash

# ── OpenAI (optional if using Gemini) ─────────────────────────────────────────
# Get from: https://platform.openai.com → API Keys
# Model used: text-embedding-3-large (3072 dimensions)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# ── Anthropic (optional if using Gemini) ──────────────────────────────────────
# Get from: https://console.anthropic.com → API Keys
# Model used: claude-sonnet-4-5
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE

# ── Cohere (optional — reranking falls back to Pinecone order if unset) ───────
# Get from: https://dashboard.cohere.ai → API Keys (1K calls/month free)
COHERE_API_KEY=YOUR_COHERE_API_KEY_HERE

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800  # 50MB in bytes

# ── CORS ──────────────────────────────────────────────────────────────────────
# In production: set to your Vercel URL
CORS_ORIGINS=["http://localhost:3000"]

# ── Observability ─────────────────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=YOUR_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=YOUR_LANGFUSE_SECRET_KEY
LOG_LEVEL=INFO
