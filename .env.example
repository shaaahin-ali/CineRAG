# Root env vars (for reference)
# Copy to apps/backend/.env.local and apps/frontend/.env.local

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Gemini ────────────────────────────────────────────────────────────────────
# Get your free key from: https://aistudio.google.com → API Keys
# This key is 100% free (15 RPM, 1500 RPD) and requires no payment cards!
GEMINI_API_KEY=your_gemini_api_key_here

# ── OpenRouter ────────────────────────────────────────────────────────────────
# Get your free key from: https://openrouter.ai/keys
# Gives access to free models like Qwen 2.5 Coder, Llama 3, etc.
OPENROUTER_API_KEY=

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=YOUR_PINECONE_KEY
PINECONE_INDEX_NAME=cinephile
# IMPORTANT: Create index with dimension=3072, metric=cosine, serverless

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=YOUR_OPENAI_KEY
# Model: text-embedding-3-large (3072 dims)

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
# Model: claude-sonnet-4-5

# ── Cohere ────────────────────────────────────────────────────────────────────
COHERE_API_KEY=YOUR_COHERE_KEY

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-this

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-this
